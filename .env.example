# Escape every dollar sign in BDE tokens as \$ (Next.js expands env variables).
BCCH_API_TOKEN=
# Official EIA key, server only. Brent remains unavailable without it.
EIA_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Keep false until privacy notice, signup restrictions and security tests are ready.
CLIENT_ACCESS_ENABLED=false
